{
    "name": "kadirov/kh-system-api",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "api-platform/doctrine-orm": "4.1.*",
        "api-platform/symfony": "4.1.*",
        "doctrine/dbal": "3.9.*",
        "doctrine/doctrine-bundle": "2.14.*",
        "doctrine/doctrine-migrations-bundle": "3.4.*",
        "doctrine/orm": "3.3.*",
        "lexik/jwt-authentication-bundle": "3.1.*",
        "nelmio/cors-bundle": "2.5.*",
        "phpdocumentor/reflection-docblock": "5.6.*",
        "phpstan/phpdoc-parser": "2.1.*",
        "symfony/asset": "7.4.*",
        "symfony/cache": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/expression-language": "7.4.*",
        "symfony/flex": "^2.11",
        "symfony/framework-bundle": "7.4.*",
        "symfony/google-mailer": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/mercure-bundle": "^0.4.3",
        "symfony/messenger": "7.4.*",
        "symfony/monolog-bundle": "^4.0.2",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/redis-messenger": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*",
        "vich/uploader-bundle": "^2.10.1"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "lint:phpstan": "phpstan analyse --memory-limit=512M",
        "lint:fixer": "php-cs-fixer fix --diff --verbose",
        "lint:fixer:check": "php-cs-fixer fix --dry-run --diff",
        "test:api": "php bin/phpunit tests/ApiTest/"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.6",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "friendsofphp/php-cs-fixer": "^3.95.25",
        "phpstan/phpstan": "^2.2.13",
        "phpstan/phpstan-symfony": "^2.0.20",
        "phpunit/phpunit": "^12.5.35",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/maker-bundle": "^1.67"
    }
}
